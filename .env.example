# Student Registration System - Environment Configuration Examples

# ==================== DATABASE ====================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=student_registration_system

# ==================== BACKEND ====================
NODE_ENV=production
BACKEND_PORT=3000
JWT_SECRET=your-super-long-secret-key-change-in-production
JWT_EXPIRY=7d
API_RATE_LIMIT=100
CORS_ORIGINS=https://your-domain.com
LOG_LEVEL=info

# ==================== FRONTEND ====================
FRONTEND_PORT=3001
REACT_APP_API_URL=/api/v1
REACT_APP_ENV=production

# ==================== MONITORING ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana-password
PROMETHEUS_RETENTION=15d

# ==================== DOCKER ====================
DOCKER_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# ==================== KUBERNETES ====================
# These can be overridden in k8s/*/secret.env files
# K8S_NAMESPACE=stud-reg-system

# ==================== CI/CD ====================
# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_ACTIONS_ENABLED=true

# Jenkins
JENKINS_URL=http://jenkins.example.com
JENKINS_TOKEN=your-jenkins-token

# Docker Registry
DOCKER_HUB_USERNAME=your-docker-username
DOCKER_HUB_PASSWORD=your-docker-password

# ArgoCD
ARGOCD_SERVER=https://argocd.example.com
ARGOCD_TOKEN=your-argocd-token

# ==================== SECURITY ====================
# Trivy
TRIVY_SEVERITY=MEDIUM,HIGH,CRITICAL
TRIVY_EXIT_CODE=1

# SonarQube
SONAR_HOST_URL=https://sonarqube.example.com
SONAR_TOKEN=your-sonarqube-token

# ==================== NOTIFICATIONS ====================
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# ==================== CLOUD PROVIDERS ====================
# AWS (if using ECR)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789000
ECR_REGISTRY=123456789000.dkr.ecr.us-east-1.amazonaws.com

# GCP (if using GKE)
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a

# Azure (if using AKS)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# ==================== BACKUP ====================
# Database backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# ==================== LOGGING ====================
# Centralized logging (ELK, Splunk, etc.)
LOG_AGGREGATION_ENABLED=true
LOG_AGGREGATION_URL=https://logs.example.com
LOG_AGGREGATION_TOKEN=your-token

# ==================== NOTES ====================
# 1. Never commit actual secrets - use .env.local in git
# 2. For Kubernetes, update secret.env files in k8s/*/
# 3. For Docker Compose, copy to .env.docker
# 4. For CI/CD, set secrets in GitHub/Jenkins
# 5. Always use strong passwords in production
# 6. Rotate secrets regularly
