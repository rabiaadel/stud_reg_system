# ============================================================================
# Student Registration System - Production Environment Configuration
# ============================================================================
# IMPORTANT: Never commit this file to version control
# IMPORTANT: Change all passwords and secrets in production
# ============================================================================

# ==================== DATABASE ====================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stud_reg_production_db
DB_USER=stud_reg_admin
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD_12345
DB_POOL_SIZE=25
DB_SSL=true

# ==================== BACKEND ====================
NODE_ENV=production
BACKEND_PORT=3000
HOST=0.0.0.0

# JWT Configuration - Generate strong secrets in production
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRY=30d

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# CORS - Set to your production domain
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ==================== FRONTEND ====================
FRONTEND_PORT=8080
REACT_APP_API_URL=https://your-domain.com/api/v1
REACT_APP_ENV=production

# ==================== EMAIL CONFIGURATION ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@tanta-university.edu
SMTP_FROM_NAME=Tanta University - Registration System

# ==================== MONITORING ====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# ==================== DOCKER ====================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_PREFIX=your-org
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=stud_reg_system

# ==================== KUBERNETES ====================
K8S_NAMESPACE=stud-reg-system
K8S_REPLICA_BACKEND=3
K8S_REPLICA_FRONTEND=2
K8S_MEMORY_LIMIT_BACKEND=1Gi
K8S_MEMORY_LIMIT_FRONTEND=512Mi
K8S_CPU_LIMIT_BACKEND=1000m
K8S_CPU_LIMIT_FRONTEND=500m

# ==================== STORAGE ====================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ==================== SECURITY ====================
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_MIN_32_CHARS

# ==================== DOMAIN & SSL ====================
DOMAIN=your-domain.com
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key
