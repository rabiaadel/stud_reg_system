# Multi-stage Dockerfile for Frontend (React)
# Stage 1: Build
FROM node:20-alpine AS builder

# Set working directory first
WORKDIR /app

# Copy package files before source code for better caching
COPY frontend/package*.json ./

# Install dependencies before copying source code
# This layer will be cached unless package.json or package-lock.json changes
RUN npm ci

# Copy the rest of the application source code
COPY frontend/ ./

# Build application
RUN npm run build

# Stage 2: Runtime (Nginx)
FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL maintainer="DevOps Team"
LABEL version="1.0"
LABEL description="Student Registration System - Frontend"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built app from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Add health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/index.html || exit 1

# Expose port
EXPOSE 8080

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
