# ============================================================================
# Backend Service - Production Environment Configuration
# ============================================================================
# Copy as: .env (in backend directory)
# NEVER commit to version control
# CHANGE all values before deploying
# ============================================================================

# ==================== DATABASE ====================
DB_HOST=postgres.example.com
DB_PORT=5432
DB_NAME=stud_reg_production_db
DB_USER=stud_reg_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12345
DB_POOL_SIZE=25
DB_SSL=true

# ==================== SERVER ====================
SERVER_PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# ==================== JWT AUTHENTICATION ====================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_KEY_MIN_32_CHARS_abc123def456ghi789jkl
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_REFRESH_SECRET_MIN_32_CHARS_xyz999abc888def777ghi
JWT_REFRESH_EXPIRY=30d

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ==================== API RATE LIMITING ====================
API_RATE_LIMIT=100
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_STORE=memory

# ==================== CORS SECURITY ====================
# Set to your production domain only
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,zip

# ==================== IMAGE UPLOAD ====================
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_QUALITY=85

# ==================== SESSION ====================
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS_abc123
SESSION_TIMEOUT=3600000

# ==================== EMAIL NOTIFICATIONS ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@tanta-university.edu
SMTP_FROM_NAME=Tanta University - Registration System

# ==================== EMAIL TEMPLATES ====================
EMAIL_VERIFICATION_ENABLED=true
SEND_WELCOME_EMAIL=true
SEND_PASSWORD_RESET_EMAIL=true
SEND_REGISTRATION_CONFIRMATION=true

# ==================== API VERSION ====================
API_VERSION=v1
API_BASE_URL=/api/v1

# ==================== SECURITY HEADERS ====================
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_MIN_32_CHARS_xyz789
ALLOW_INSECURE_PASSWORDS=false
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# ==================== DATABASE FEATURES ====================
USE_CONNECTION_POOLING=true
AUTO_MIGRATE_ON_START=false
SEED_DATABASE_ON_EMPTY=false

# ==================== MONITORING & LOGGING ====================
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_ERROR_TRACKING=true
ENABLE_PROMETHEUS_METRICS=true

# ==================== CACHING ====================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_STRATEGY=memory

# ==================== FEATURE FLAGS ====================
ENABLE_REGISTRATION=true
ENABLE_GRADE_SUBMISSION=true
ENABLE_COURSE_WITHDRAWAL=true
ENABLE_GRADUATION_APPLICATION=true
ENABLE_APPEAL_SYSTEM=true

# ==================== THIRD PARTY INTEGRATIONS ====================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFICATIONS_ENABLED=false
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_ENABLED=false

# ==================== BACKUP ====================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ==================== DEBUG ====================
DEBUG=false
VERBOSE_LOGGING=false
STACK_TRACE_ON_ERROR=false
