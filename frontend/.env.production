# ============================================================================
# Frontend Service - Production Environment Configuration
# ============================================================================
# Copy as: .env.production (in frontend directory)
# NEVER commit to version control
# Change domain before deploying
# ============================================================================

# ==================== API CONFIGURATION ====================
REACT_APP_API_URL=/api/v1
REACT_APP_ENV=production

# ==================== APP NAME ====================
REACT_APP_NAME=Faculty of Computers and Informatics
REACT_APP_UNIVERSITY=Tanta University
REACT_APP_VERSION=1.0.0

# ==================== FEATURE FLAGS ====================
REACT_APP_ENABLE_REGISTRATION=true
REACT_APP_ENABLE_COURSE_WITHDRAWAL=true
REACT_APP_ENABLE_GRADUATION_APPLY=true
REACT_APP_ENABLE_APPEALS=true

# ==================== UI CONFIGURATION ====================
REACT_APP_THEME=light
REACT_APP_ITEMS_PER_PAGE=25
REACT_APP_MAX_FILE_SIZE=10485760

# ==================== DEBUGGING ====================
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=error

# ==================== SECURITY ====================
REACT_APP_SECURE_COOKIES=true
REACT_APP_HTTPS_ONLY=true

# ==================== OTHER ====================
REACT_APP_AUTO_LOGOUT_MINUTES=30
REACT_APP_SESSION_WARNING_MINUTES=5
GENERATE_SOURCEMAP=false
